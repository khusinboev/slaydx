# standart joyi repo/build kontekstidan tashqarida (/etc/slaydx/backup.env),
# lekin shu nomdagi fayl repo ichida qolib ketsa ham `builder`ning
# `COPY . .` orqali image qatlamiga (BACKUP_REMOTE/TELEGRAM_BOT_TOKEN) kirmasin.
.backup.env
