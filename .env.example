# ── Asosiy ────────────────────────────────────────────────────────────
# Tashqi manzil. Cookie, webhook va sitemap shundan quriladi.
APP_URL=http://localhost:3000
# Brend — nom va logo. Kodda boshqa joyda qattiq yozilmagan.
# Ochilishdan oldin ikkalasini ham o'zingiznikiga almashtiring:
# loyiha `sodda.ai` klonidan boshlangan, bu huquqiy masala.
NEXT_PUBLIC_BRAND_NAME=SlaydX
NEXT_PUBLIC_BRAND_LOGO=/logo.png

# Qo'shimcha ruxsat etilgan manzillar (vergul bilan). Odatda kerak emas:
# sayt qaysi manzilda ochilgan bo'lsa, o'sha manzil avtomatik ruxsat etiladi
# (127.0.0.1, tarmoq IP, www varianti — hammasi ishlaydi).
# ALLOWED_ORIGINS=https://mini.example.uz

# ── Ma'lumotlar bazasi (MAJBURIY) ────────────────────────────────────
DATABASE_URL=postgres://slaydx:slaydx@localhost:5432/slaydx
DATABASE_POOL_MAX=10

# ── Sessiya (prod da MAJBURIY, kamida 32 belgi) ──────────────────────
# Yaratish: openssl rand -base64 48
SESSION_SECRET=
SESSION_TTL_DAYS=30

# Cookie SameSite: lax | none
#   lax  — xavfsizroq, standart.
#   none — Telegram'ning WEB versiyasi (web.telegram.org) Mini App ni
#          iframe da ochadi; u yerda `lax` cookie umuman yuborilmaydi
#          va foydalanuvchi kirgandan keyin darhol chiqib qolgandek
#          ko'rinadi. `none` HTTPS talab qiladi.
# Mobil Telegram ilovasida (WebView) `lax` ham ishlaydi.
SESSION_COOKIE_SAMESITE=lax

# Reverse proxy (nginx, Cloudflare, Vercel) ortidamisiz?
# `false` bo'lsa `x-forwarded-for` ga ishonilmaydi — bu sarlavhani
# foydalanuvchi ham yuborishi mumkin va IP chegarasini aylanib o'tardi.
TRUST_PROXY=false

# ── Autentifikatsiya ─────────────────────────────────────────────────
# @BotFather dan olinadi. Bo'lmasa Telegram kirish o'chadi.
# Bot username @ siz yoziladi (masalan: SlaydX_bot).
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT=

# Lokalda: `npm run bot` (long-polling, ochiq HTTPS kerak emas).
# Prod da: webhook o'rnating —
#   curl -F "url=https://<domen>/api/telegram/webhook" \
#        -F "secret_token=<CRON_SECRET>" \
#        "https://api.telegram.org/bot<TOKEN>/setWebhook"

# Zaxira OTP kodini javobda ko'rsatadi — FAQAT lokal/staging uchun.
# Prod da yoqilsa server ishga tushmaydi (himoya).
DEV_LOGIN_ENABLED=false

# ── LLM (matn yozish) ────────────────────────────────────────────────
# Kalit qo'yilmasa generatsiya shablon rejimida ishlaydi (LLM chaqirilmaydi).
# Mavjud modellarni tekshirish:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY"
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Ixtiyoriy zaxira — GEMINI_API_KEY bo'lmasa ishlatiladi.
XAI_API_KEY=
XAI_MODEL=grok-4.3

# Gemini «o'ylash» byudjeti (token). Bo'sh qoldiring — dvigatel o'zi
# hal qiladi: kurs ishi bo'limlarida 1024, qolgan hamma joyda 0.
# Bu yerga son yozilsa HAMMA chaqiruvga majburan qo'llanadi.
GEMINI_THINKING_BUDGET=

# ── Rasm (slayd rasmlari va «Rasm generate») ─────────────────────────
# Kalit bo'lmasa slaydlar rasmsiz, «Rasm» vositasi esa ishlamaydi.
FAL_KEY=
FAL_MODEL=fal-ai/flux/schnell

# Oddiy `slide` vositasi uchun BEPUL stock-foto zanjiri (P3):
#   Pexels → Pixabay → fal.ai (AI chizadi).
# Ikkalasi ham ixtiyoriy — bo'sh qoldirilsa zanjir bir zumda fal'ga
# tushadi, ya'ni HECH NARSA o'zgarmaydi (regressiya yo'q). Faqat uslub
# «Foto» tanlanganda ishlaydi (Doska/Illyustratsiya/Minimal — to'g'ridan
# to'g'ri fal, stock arxiv mos kelmaydi).
#
# PEXELS_API_KEY — bepul, ro'yxatdan o'tib olinadi: https://www.pexels.com/api/
# (Your API Key sahifasi). Limit: 200 so'rov/soat, 20000/oy — bepul reja.
PEXELS_API_KEY=
# PIXABAY_API_KEY — bepul, ro'yxatdan o'tib olinadi: https://pixabay.com/api/docs/
# (sahifa pastida "Your API Key"). Limit: 100 so'rov/daqiqa — bepul reja.
PIXABAY_API_KEY=
# «Premium» yo'l uchun: sifatliroq model va ko'proq inference qadami.
# Mustaqil «Rasm generate» vositasi ENDI DOIM shu yo'ldan ishlaydi —
# jonli tekshiruvda (`npm run image-lab`) `flux/schnell` past qadamda
# uslublar orasidagi farqni deyarli chizolmasligi (foto/kino/3D/minimal
# deyarli bir xil chiqishi) aniqlandi. `flux/dev` + 28 qadam bilan
# uslublar haqiqatan ham farqlanadi. Bo'sh qoldirilsa FAL_MODEL va 8
# qadam ishlatiladi — lekin bu holda uslub farqi kuchsiz bo'ladi.
FAL_MODEL_PREMIUM=fal-ai/flux/dev
FAL_STEPS=
FAL_STEPS_PREMIUM=28

# «Pro slayd» rasmlari fal.ai ga EMAS, Gemini rasm modeliga boradi
# (`lib/generation/image-provider.ts` `pickProvider`). Sabab: pro'da
# slaydiga alohida to'lanadi va Gemini prompt matnini (ayniqsa
# o'zbekcha mavzu tarjimasini) sezilarli aniqroq o'qiydi. Kalit
# alohida emas — yuqoridagi GEMINI_API_KEY ishlatiladi; u bo'lmasa
# pro deka rasmsiz chiqadi (va'da qilinmaydi, pul ushlanmaydi).
#
# Narx: 1K da ~$0.067/rasm. Arzonroq zaxira — gemini-3.1-flash-lite-image
# (~$0.034), sifati pastroq.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Rasm o'lchami: 1K yoki 2K. 2K narxni oshiradi, slaydda esa 1K
# `slotPixels` bergan 1024 px li slotdan allaqachon katta.
GEMINI_IMAGE_SIZE=1K

# ── PDF eksport ──────────────────────────────────────────────────────
# DOCX/PPTX ni PDF ga LibreOffice o'giradi. Docker tasviriga u allaqachon
# qo'shilgan; lokalda `libreoffice` o'rnatilgan bo'lsa o'zi topiladi.
# Boshqa joyda bo'lsa yo'lni ko'rsating. Bo'sh bo'lsa va LibreOffice
# topilmasa — PDF tugmasi UI da chiqmaydi.
SOFFICE_BIN=

# ── Navbat (worker) ──────────────────────────────────────────────────
# true — worker web process ichida ishlaydi (kichik o'rnatish uchun).
# false — `npm run worker` ni alohida konteynerda ko'taring.
WORKER_INLINE=true
WORKER_CONCURRENCY=2
# Bitta ishning YUQORI chegarasi. Haqiqiy byudjet har ishning hajmidan
# hisoblanadi (`lib/generation/budget.ts`) va shundan oshmaydi.
# 300000 kichik: 45 betlik kurs ishi ~477 s, 16 slaydli premium deka
# ~296 s talab qiladi — shift past bo'lsa eng qimmat tariflar bir xil
# vaqt olib, hajm darvozasidan muntazam yiqilardi.
WORKER_JOB_TIMEOUT_MS=480000

# ── To'lov ───────────────────────────────────────────────────────────
# Kalitlar bo'lmasa tegishli usul UI da «o'chiq» ko'rinadi.
# Webhook manzillari:
#   Click — $APP_URL/api/payments/click   (Prepare va Complete uchun bir xil)
#   Payme — $APP_URL/api/payments/payme
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=

PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST_KEY=

# ── Ichki ────────────────────────────────────────────────────────────
# Telegram webhook'ini va batafsil `/api/health` javobini himoyalaydi.
# Bot ishlatilsa prod da MAJBURIY.
# Yaratish: openssl rand -hex 24
CRON_SECRET=

# ── Maqola 2 (AUDIT-17) ────────────────────────────────────────────────
# LLM ROLLARI — `provider:model[,provider:model…]` (vergul = zaxira zanjiri:
# birinchisi 429/5xx bersa keyingisiga o'tiladi). Berilmasa — GEMINI_MODEL.
# provider: gemini | anthropic | openrouter | xai | openai
LLM_WRITER=gemini:gemini-3.7-flash
LLM_RESEARCHER=gemini:gemini-3.7-flash
LLM_JUDGE=anthropic:claude-sonnet-5,gemini:gemini-3.7-flash
LLM_FAST=gemini:gemini-3.7-flash
# Anthropic — tayyorlik hisoboti baholovchisi va zaxira (O'zbekistonda rasman mavjud).
ANTHROPIC_API_KEY=
# OpenRouter — universal zaxira (GPT/DeepSeek/Qwen bitta kalit bilan).
OPENROUTER_API_KEY=
# Manba qidiruv: OpenAlex (2026-02 dan bepul API kalit majburiy, kunlik $1
# bepul) va Crossref («polite pool» uchun mailto).
OPENALEX_API_KEY=
OPENALEX_MAILTO=
CROSSREF_MAILTO=
# Maqola byudjeti 15 betda ~390 s — worker chegarasi undan katta bo'lsin.
WORKER_JOB_TIMEOUT_MS=660000
