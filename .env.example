# ── Asosiy ────────────────────────────────────────────────────────────
# Tashqi manzil. Cookie, webhook va sitemap shundan quriladi.
APP_URL=http://localhost:3000
# Brend — nom va logo. Kodda boshqa joyda qattiq yozilmagan.
# Ochilishdan oldin ikkalasini ham o'zingiznikiga almashtiring:
# loyiha `sodda.ai` klonidan boshlangan, bu huquqiy masala.
NEXT_PUBLIC_BRAND_NAME=Sodda.ai
NEXT_PUBLIC_BRAND_LOGO=/logo.png

# Qo'shimcha ruxsat etilgan manzillar (vergul bilan). Odatda kerak emas:
# sayt qaysi manzilda ochilgan bo'lsa, o'sha manzil avtomatik ruxsat etiladi
# (127.0.0.1, tarmoq IP, www varianti — hammasi ishlaydi).
# ALLOWED_ORIGINS=https://mini.example.uz

# ── Ma'lumotlar bazasi (MAJBURIY) ────────────────────────────────────
DATABASE_URL=postgres://sodda:sodda@localhost:5432/sodda
DATABASE_POOL_MAX=10

# ── Sessiya (prod da MAJBURIY, kamida 32 belgi) ──────────────────────
# Yaratish: openssl rand -base64 48
SESSION_SECRET=
SESSION_TTL_DAYS=30

# Cookie SameSite: lax | none
#   lax  — xavfsizroq, standart.
#   none — Telegram'ning WEB versiyasi (web.telegram.org) Mini App ni
#          iframe da ochadi; u yerda `lax` cookie umuman yuborilmaydi
#          va foydalanuvchi kirgandan keyin darhol chiqib qolgandek
#          ko'rinadi. `none` HTTPS talab qiladi.
# Mobil Telegram ilovasida (WebView) `lax` ham ishlaydi.
SESSION_COOKIE_SAMESITE=lax

# Reverse proxy (nginx, Cloudflare, Vercel) ortidamisiz?
# `false` bo'lsa `x-forwarded-for` ga ishonilmaydi — bu sarlavhani
# foydalanuvchi ham yuborishi mumkin va IP chegarasini aylanib o'tardi.
TRUST_PROXY=false

# ── Autentifikatsiya ─────────────────────────────────────────────────
# @BotFather dan olinadi. Bo'lmasa Telegram kirish o'chadi.
# Bot username @ siz yoziladi (masalan: SI_taqdimot_bot).
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT=

# Lokalda: `npm run bot` (long-polling, ochiq HTTPS kerak emas).
# Prod da: webhook o'rnating —
#   curl -F "url=https://<domen>/api/telegram/webhook" \
#        -F "secret_token=<CRON_SECRET>" \
#        "https://api.telegram.org/bot<TOKEN>/setWebhook"

# Zaxira OTP kodini javobda ko'rsatadi — FAQAT lokal/staging uchun.
# Prod da yoqilsa server ishga tushmaydi (himoya).
DEV_LOGIN_ENABLED=false

# ── LLM (matn yozish) ────────────────────────────────────────────────
# Kalit qo'yilmasa generatsiya shablon rejimida ishlaydi (LLM chaqirilmaydi).
# Mavjud modellarni tekshirish:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY"
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Ixtiyoriy zaxira — GEMINI_API_KEY bo'lmasa ishlatiladi.
XAI_API_KEY=
XAI_MODEL=grok-4.3

# Gemini «o'ylash» byudjeti (token). Bo'sh qoldiring — dvigatel o'zi
# hal qiladi: kurs ishi bo'limlarida 1024, qolgan hamma joyda 0.
# Bu yerga son yozilsa HAMMA chaqiruvga majburan qo'llanadi.
GEMINI_THINKING_BUDGET=

# ── Rasm (slayd rasmlari va «Rasm generate») ─────────────────────────
# Kalit bo'lmasa slaydlar rasmsiz, «Rasm» vositasi esa ishlamaydi.
FAL_KEY=
FAL_MODEL=fal-ai/flux/schnell
# «Premium» paketlar uchun: sifatliroq model va ko'proq inference qadami.
# Bo'sh qoldirilsa FAL_MODEL ishlatiladi, qadam esa 8 bo'ladi.
FAL_MODEL_PREMIUM=
FAL_STEPS=
FAL_STEPS_PREMIUM=

# ── PDF eksport ──────────────────────────────────────────────────────
# DOCX/PPTX ni PDF ga LibreOffice o'giradi. Docker tasviriga u allaqachon
# qo'shilgan; lokalda `libreoffice` o'rnatilgan bo'lsa o'zi topiladi.
# Boshqa joyda bo'lsa yo'lni ko'rsating. Bo'sh bo'lsa va LibreOffice
# topilmasa — PDF tugmasi UI da chiqmaydi.
SOFFICE_BIN=

# ── Navbat (worker) ──────────────────────────────────────────────────
# true — worker web process ichida ishlaydi (kichik o'rnatish uchun).
# false — `npm run worker` ni alohida konteynerda ko'taring.
WORKER_INLINE=true
WORKER_CONCURRENCY=2
WORKER_JOB_TIMEOUT_MS=300000

# Yaratilgan fayl necha soat saqlanadi.
FILE_TTL_HOURS=72

# ── To'lov ───────────────────────────────────────────────────────────
# Kalitlar bo'lmasa tegishli usul UI da «o'chiq» ko'rinadi.
# Webhook manzillari:
#   Click — $APP_URL/api/payments/click   (Prepare va Complete uchun bir xil)
#   Payme — $APP_URL/api/payments/payme
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=

PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST_KEY=

# ── Ichki ────────────────────────────────────────────────────────────
# Telegram webhook'ini va batafsil `/api/health` javobini himoyalaydi.
# Bot ishlatilsa prod da MAJBURIY.
# Yaratish: openssl rand -hex 24
CRON_SECRET=
