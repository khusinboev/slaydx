# ── Asosiy ────────────────────────────────────────────────────────────
# Tashqi manzil. Cookie, webhook va sitemap shundan quriladi.
APP_URL=http://localhost:3000
# Brend — nom va logo. Kodda boshqa joyda qattiq yozilmagan.
# Ochilishdan oldin ikkalasini ham o'zingiznikiga almashtiring:
# loyiha `sodda.ai` klonidan boshlangan, bu huquqiy masala.
NEXT_PUBLIC_BRAND_NAME=SlaydX
NEXT_PUBLIC_BRAND_LOGO=/logo.png

# Qo'shimcha ruxsat etilgan manzillar (vergul bilan). Odatda kerak emas:
# sayt qaysi manzilda ochilgan bo'lsa, o'sha manzil avtomatik ruxsat etiladi
# (127.0.0.1, tarmoq IP, www varianti — hammasi ishlaydi).
# ALLOWED_ORIGINS=https://mini.example.uz

# ── Ma'lumotlar bazasi (MAJBURIY) ────────────────────────────────────
DATABASE_URL=postgres://slaydx:slaydx@localhost:5432/slaydx
DATABASE_POOL_MAX=10

# ── Sessiya (prod da MAJBURIY, kamida 32 belgi) ──────────────────────
# Yaratish: openssl rand -base64 48
SESSION_SECRET=
SESSION_TTL_DAYS=30

# Cookie SameSite: lax | none
#   lax  — xavfsizroq, standart.
#   none — Telegram'ning WEB versiyasi (web.telegram.org) Mini App ni
#          iframe da ochadi; u yerda `lax` cookie umuman yuborilmaydi
#          va foydalanuvchi kirgandan keyin darhol chiqib qolgandek
#          ko'rinadi. `none` HTTPS talab qiladi.
# Mobil Telegram ilovasida (WebView) `lax` ham ishlaydi.
SESSION_COOKIE_SAMESITE=lax

# Reverse proxy (nginx, Cloudflare, Vercel) ortidamisiz?
# `false` bo'lsa `x-forwarded-for` ga ishonilmaydi — bu sarlavhani
# foydalanuvchi ham yuborishi mumkin va IP chegarasini aylanib o'tardi.
TRUST_PROXY=false

# ── Autentifikatsiya ─────────────────────────────────────────────────
# @BotFather dan olinadi. Bo'lmasa Telegram kirish o'chadi.
# Bot username @ siz yoziladi (masalan: SlaydX_bot).
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT=

# Lokalda: `npm run bot` (long-polling, ochiq HTTPS kerak emas).
# Prod da: webhook o'rnating —
#   curl -F "url=https://<domen>/api/telegram/webhook" \
#        -F "secret_token=<CRON_SECRET>" \
#        "https://api.telegram.org/bot<TOKEN>/setWebhook"

# Zaxira OTP kodini javobda ko'rsatadi — FAQAT lokal/staging uchun.
# Prod da yoqilsa server ishga tushmaydi (himoya).
DEV_LOGIN_ENABLED=false

# ── LLM (matn yozish) ────────────────────────────────────────────────
# Kalit qo'yilmasa generatsiya shablon rejimida ishlaydi (LLM chaqirilmaydi).
# Mavjud modellarni tekshirish:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY"
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Ixtiyoriy zaxira — GEMINI_API_KEY bo'lmasa ishlatiladi.
XAI_API_KEY=
XAI_MODEL=grok-4.3

# Gemini «o'ylash» byudjeti (token). Bo'sh qoldiring — dvigatel o'zi
# hal qiladi: kurs ishi bo'limlarida 1024, qolgan hamma joyda 0.
# Bu yerga son yozilsa HAMMA chaqiruvga majburan qo'llanadi.
GEMINI_THINKING_BUDGET=

# ── Rasm (slayd rasmlari va «Rasm generate») ─────────────────────────
# Kalit bo'lmasa slaydlar rasmsiz, «Rasm» vositasi esa ishlamaydi.
FAL_KEY=
FAL_MODEL=fal-ai/flux/schnell

# Oddiy `slide` vositasi uchun BEPUL stock-foto zanjiri (P3):
#   Pexels → Pixabay → fal.ai (AI chizadi).
# Ikkalasi ham ixtiyoriy — bo'sh qoldirilsa zanjir bir zumda fal'ga
# tushadi, ya'ni HECH NARSA o'zgarmaydi (regressiya yo'q). Faqat uslub
# «Foto» tanlanganda ishlaydi (Doska/Illyustratsiya/Minimal — to'g'ridan
# to'g'ri fal, stock arxiv mos kelmaydi).
#
# PEXELS_API_KEY — bepul, ro'yxatdan o'tib olinadi: https://www.pexels.com/api/
# (Your API Key sahifasi). Limit: 200 so'rov/soat, 20000/oy — bepul reja.
PEXELS_API_KEY=
# PIXABAY_API_KEY — bepul, ro'yxatdan o'tib olinadi: https://pixabay.com/api/docs/
# (sahifa pastida "Your API Key"). Limit: 100 so'rov/daqiqa — bepul reja.
PIXABAY_API_KEY=
# «Premium» yo'l uchun: sifatliroq model va ko'proq inference qadami.
# Mustaqil «Rasm generate» vositasi ENDI DOIM shu yo'ldan ishlaydi —
# jonli tekshiruvda (`npm run image-lab`) `flux/schnell` past qadamda
# uslublar orasidagi farqni deyarli chizolmasligi (foto/kino/3D/minimal
# deyarli bir xil chiqishi) aniqlandi. `flux/dev` + 28 qadam bilan
# uslublar haqiqatan ham farqlanadi. Bo'sh qoldirilsa FAL_MODEL va 8
# qadam ishlatiladi — lekin bu holda uslub farqi kuchsiz bo'ladi.
FAL_MODEL_PREMIUM=fal-ai/flux/dev
FAL_STEPS=
FAL_STEPS_PREMIUM=28

# «Rasm» vositasi VA «Pro slayd» rasmlari fal.ai ga EMAS, Gemini rasm
# modeliga boradi (`lib/generation/image-provider.ts` `pickProvider`,
# `lib/generation/image-studio.ts`). Sabab: Gemini prompt matnini
# (ayniqsa o'zbekcha mavzu tarjimasini) sezilarli aniqroq o'qiydi.
# Kalit alohida emas — yuqoridagi GEMINI_API_KEY ishlatiladi; u bo'lmasa
# rasm/pro deka rasmsiz chiqadi (va'da qilinmaydi, pul ushlanmaydi).
#
# Standart — lite model, $0.034/rasm (1K). Yuqori sifat ixtiyoriy:
# gemini-3.1-flash-image ($0.067) — shu o'zgaruvchiga yozib yoqiladi.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
# Rasm o'lchami: 1K yoki 2K. 2K narxni oshiradi, slaydda esa 1K
# `slotPixels` bergan 1024 px li slotdan allaqachon katta.
GEMINI_IMAGE_SIZE=1K

# ── PDF eksport ──────────────────────────────────────────────────────
# DOCX/PPTX ni PDF ga LibreOffice o'giradi. Docker tasviriga u allaqachon
# qo'shilgan; lokalda `libreoffice` o'rnatilgan bo'lsa o'zi topiladi.
# Boshqa joyda bo'lsa yo'lni ko'rsating. Bo'sh bo'lsa va LibreOffice
# topilmasa — PDF tugmasi UI da chiqmaydi.
SOFFICE_BIN=

# ── Navbat (worker) ──────────────────────────────────────────────────
# true — worker web process ichida ishlaydi (kichik o'rnatish uchun).
# false — `npm run worker` ni alohida konteynerda ko'taring.
WORKER_INLINE=true
WORKER_CONCURRENCY=2
# Bitta ishning YUQORI chegarasi. Haqiqiy byudjet har ishning hajmidan
# hisoblanadi (`lib/generation/budget.ts`) va shundan oshmaydi.
# 300000 kichik: 45 betlik kurs ishi ~477 s, 16 slaydli premium deka
# ~296 s talab qiladi — shift past bo'lsa eng qimmat tariflar bir xil
# vaqt olib, hajm darvozasidan muntazam yiqilardi.
WORKER_JOB_TIMEOUT_MS=480000

# ── To'lov ───────────────────────────────────────────────────────────
# Kalitlar bo'lmasa tegishli usul UI da «o'chiq» ko'rinadi.
# Webhook manzillari:
#   Click — $APP_URL/api/payments/click   (Prepare va Complete uchun bir xil)
#   Payme — $APP_URL/api/payments/payme
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=

PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST_KEY=

# ── Ichki ────────────────────────────────────────────────────────────
# Telegram webhook'ini va batafsil `/api/health` javobini himoyalaydi.
# Bot ishlatilsa prod da MAJBURIY.
# Yaratish: openssl rand -hex 24
CRON_SECRET=

# ── Maqola 2 (AUDIT-17) ────────────────────────────────────────────────
# LLM ROLLARI — `provider:model[,provider:model…]` (vergul = ZAXIRA ZANJIRI:
# birinchisi 3 marta 429/5xx/tarmoq xatosi bersa keyingisiga o'tiladi; 4xx
# yoki timeout — darhol to'xtaydi, keyingisiga o'TIlmaydi). Bo'sh qoldirilsa
# `complete(role,…)` HOZIRGI standart provayderga tushadi (`GEMINI_API_KEY`
# bo'lsa Gemini, aks holda `XAI_API_KEY`) — boshqa vositalar (slayd, kurs
# ishi, tarjimon) shu bilan ishlaydi va bu o'zgarmaydi.
# provider: gemini | anthropic | openrouter | xai | openai
# Kaliti yo'q provayder zanjirda jimgina o'tkazib yuboriladi (jurnalda
# "kalit yo'q" yozuvi bilan) — xato emas.
LLM_WRITER=gemini:gemini-3.7-flash
LLM_RESEARCHER=gemini:gemini-3.7-flash
LLM_JUDGE=anthropic:claude-sonnet-5,gemini:gemini-3.7-flash
LLM_FAST=gemini:gemini-3.7-flash
# Anthropic — tayyorlik hisoboti baholovchisi va zaxira yozuvchi
# (O'zbekistonda rasman mavjud, `@anthropic-ai/sdk`). SOTIB OLINADI.
ANTHROPIC_API_KEY=
# OpenRouter — universal zaxira (GPT/DeepSeek/Qwen bitta kalit bilan,
# narx + 5,5%). SOTIB OLINADI.
OPENROUTER_API_KEY=
# OpenAI — to'g'ridan-to'g'ri adapter tayyor (`lib/generation/llm/openai.ts`),
# lekin SOTIB OLINMAYDI: OpenRouter allaqachon GPT modellariga yetadi.
# Kalit qo'yilsa zanjirda ishlatiladi, bo'sh qoldirilsa o'tkazib yuboriladi.
OPENAI_API_KEY=
# Manba qidiruv: OpenAlex (2026-02 dan bepul API kalit majburiy, kunlik $1
# bepul) va Crossref («polite pool» uchun mailto).
OPENALEX_API_KEY=
OPENALEX_MAILTO=
CROSSREF_MAILTO=
# Google Books — kurs ishi/referat uchun darslik va monografiya manbalari
# (AUDIT-19). Kod kalitsiz ham ishlaydi, LEKIN 2026-09 tekshiruvida
# kalitsiz so'rov `HTTP 429` (anonim kvota) qaytardi — PRODDA KALIT QO'YING,
# aks holda kitob manbalari umuman topilmaydi (hisobotda «manba yetishmayapti»).
# Olish: https://console.cloud.google.com → «Books API» → API key (kuniga 1 000).
GOOGLE_BOOKS_API_KEY=
# Maqola byudjeti 15 betda ~390 s — worker chegarasi undan katta bo'lsin.
WORKER_JOB_TIMEOUT_MS=660000

# ── Bepul LLM endpointlari — sarf shifti (prod-readiness C10) ─────────
# Reja (`/api/outline`), UDK taklifi, «Tuzatish» (`…/rewrite`) va
# «Hammasini tuzatish» (`…/polish`) kredit YECHMAYDI — provayder puli faqat
# shu chegaralar bilan to'siladi. Kun Toshkent vaqti bilan (00:00 UTC+5).
# «Tuzatish»/«Hammasini tuzatish» faqat pul (balans yoki Pro kvota) bilan
# to'langan hujjatda ishlaydi — faqat bonus ball bilan yaratilganda 402.
# O'chirish tugmasi: true → to'rttala endpoint darhol 503 (pullik
# generatsiya ishlayveradi). Qo'llash: `docker compose up -d web`.
FREE_LLM_DISABLED=false
# Foydalanuvchi bo'yicha kunlik chegara (qisqa oynali chegaralar ham qoladi).
FREE_LLM_DAILY_OUTLINE=20
FREE_LLM_DAILY_UDK=20
FREE_LLM_DAILY_REWRITE=30
FREE_LLM_DAILY_POLISH=10
# Barcha foydalanuvchilar bo'yicha kunlik birlik — oshsa 503. Vazn: reja 2,
# UDK 1, tuzatish 1, hammasini tuzatish 7 (≤6 yozuvchi + baholovchi).
FREE_LLM_DAILY_GLOBAL=20000

# ── TTS (AUDIT-22: podkast, tabriknoma) ────────────────────────────────
# Matndan ovozga. `docs/research/tts.md`: o'zbekcha (`uz-UZ`) rasmiy
# ovozni FAQAT Azure (`uz-UZ-MadinaNeural`/`SardorNeural`) va mahalliy
# Aisha AI beradi — Google/ElevenLabs/Yandex da yo'q. Zanjir tartibi:
# Azure → Aisha → (ixtiyoriy) Gemini preview.
#
# AZURE_SPEECH_KEY + AZURE_SPEECH_REGION — portal.azure.com → "Create a
# resource" → Speech → F0 (bepul, 0.5M belgi/oy) yoki S0 → "Keys and
# Endpoint" dan KEY1 va Region (masalan `westeurope`).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# AISHA_API_KEY — voicelab.uz/app da ro'yxatdan o'tib, balansni to'ldirib
# (1 so'm/belgi), profil/API bo'limidan olinadi. Chiqish WAV va so'rovga
# 1 000 belgi chegara bor — ikkalasini ham kod o'zi hal qiladi.
AISHA_API_KEY=
# TTS_GEMINI_MODEL — Gemini TTS PREVIEW modeli (masalan
# `gemini-2.5-flash-preview-tts`). BO'SH QOLDIRILSA provayder butunlay
# o'chiq: preview modelning o'zbekcha sifati sinovdan o'tmagan va SLA
# yo'q, shuning uchun u ataylab yoqiladi (`GEMINI_API_KEY` yetarli emas).
TTS_GEMINI_MODEL=
# TTS_VOICE_<TIL> — shu til uchun ovoz zanjiri, `provider:voice` vergul
# bilan. Jadvalni (`lib/generation/tts/types.ts TTS_LANG_VOICES`)
# ALMASHTIRADI. Birinchi ovoz — rol A, ikkinchisi — rol B (podkast
# dialogi), keyingilari zaxira provayder.
# TTS_VOICE_UZ=azure:uz-UZ-MadinaNeural,azure:uz-UZ-SardorNeural,aisha:gulnoza
# TTS_VOICE_RU=azure:ru-RU-SvetlanaNeural,azure:ru-RU-DmitryNeural

# ─── Prod-readiness W2 (audit/designs/capacity.md, retention.md) ───
# Navbat to'lsa (taxminiy kutish > QUEUE_MAX_WAIT_SEC) yangi ish pul yechilmasdan 429 oladi.
QUEUE_TOTAL_SLOTS=8
QUEUE_MEAN_SERVICE_SEC=200
QUEUE_MAX_WAIT_SEC=900
USER_MAX_INFLIGHT=2
QUEUE_TTL_SEC=2700
# Faqat bonus bilan yaratilgan hujjat fayllari shuncha kundan keyin o'chiriladi (pullik — muddatsiz).
RETENTION_BONUS_DAYS=180
PDF_MAX_CONCURRENCY=2
# Payme sinov kaliti faqat PAYME_SANDBOX=true bo'lsa qabul qilinadi — prod'da bo'sh qoldiring.
PAYME_SANDBOX=

# ─── Konteyner resurs chegaralari (prod-readiness C18; docker-compose.yml) ───
# Server boshqa loyihalar bilan umumiy — bittasi xotirani yeb, qolganlarini o'ldirmasin.
WEB_MEM_LIMIT=2g
WEB_CPUS=2
WORKER_MEM_LIMIT=2g
WORKER_CPUS=2
PG_MEM_LIMIT=1g
PG_CPUS=1
# WORKER_INLINE berilmasa: production'da o'chiq (alohida worker konteyneri), dev'da yoqiq.
