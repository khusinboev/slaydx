# belt-and-braces (reviewer R2a: sirlar image qatlamiga/git'ga tushmasin).
.backup.env
*.backup.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# lokal ma'lumot va jurnallar
/.data

# Eval chiqishi — o'lchov natijasi, kod emas
eval-out/

